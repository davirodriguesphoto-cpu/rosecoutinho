# Copie para .env.local (uso local) ou cadastre na Vercel em Settings > Environment Variables.
# Navegador (públicas): Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publicavel

# --- Só no servidor (Vercel, SEM o prefixo VITE_, marcar como Sensitive) ---
# Nunca coloque estas no navegador nem no GitHub.
# SUPABASE_SERVICE_ROLE_KEY=chave-secret-do-supabase
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# CRON_SECRET=texto-longo-aleatorio     (liga o backup automático diário)
# APP_URL=https://painel.rosecoutinho.com.br
